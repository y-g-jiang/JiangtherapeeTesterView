{
  "name": "jptc-collect",
  "private": true,
  "version": "0.1.0",
  "description": "Contributor-side capture and analysis tool for PTC, ISO gain and dark-frame spectra.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build:native": "node-gyp rebuild -C native && node -e \"const fs=require('fs');fs.mkdirSync('native/prebuilt',{recursive:true});fs.copyFileSync('native/build/Release/libraw_binding.node','native/prebuilt/libraw_binding.node')\"",
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on tcp:5180 && cross-env VITE_DEV_SERVER_URL=http://localhost:5180 electron .\"",
    "build:renderer": "vite build",
    "start": "npm run build:renderer && electron .",
    "pack": "npm run build:renderer && electron-builder --win --x64",
    "probe": "node scripts/probe-raw.mjs",
    "dark": "node scripts/dark-pair.mjs",
    "test": "vitest run --config vitest.config.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "node-addon-api": "^8.3.0",
    "node-gyp": "^11.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "io.github.ygjiang.jptc-collect",
    "productName": "JPTC Collect",
    "files": [
      "electron/**/*",
      "src/analysis/**/*",
      "src/dsp/**/*",
      "src/output/**/*",
      "dist/renderer/**/*",
      "src/nativePath.cjs",
      "native/prebuilt/*.node"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}